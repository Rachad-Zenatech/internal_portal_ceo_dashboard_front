# ==============================================================================
# CEO Dashboard Portal - Frontend Environment Configuration
# ==============================================================================

# API Base URL (Web)
# In production, when the frontend and backend are served behind the same reverse proxy / domain,
# this can be left blank or set to your production API gateway URL:
VITE_API_BASE_URL=http://localhost:8005

# Admin Portal URL (for external redirects & deep linking)
VITE_ADMIN_PORTAL_URL=http://localhost:5174

# Mobile App Deep Link Scheme (e.g. zenadashboard:// in production or exp:// in dev)
VITE_MOBILE_APP_URL=exp://localhost:8090

# --- Native (Expo / React Native) Environment Variables ---
# In mobile builds, Expo inlines EXPO_PUBLIC_* variables at bundle time.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8005
EXPO_PUBLIC_ADMIN_PORTAL_URL=http://localhost:5174
EXPO_PUBLIC_MOBILE_APP_SCHEME=zenadashboard
